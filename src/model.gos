// The application state: windows, each with its tabs in order and the one
// showing, and the operations that open, close, show and move them. Every
// operation queues the effects that keep titles and focus in step. Closing
// what still runs a program's job asks first.

use std::{errors, fs, path}
use std::encoding::json

use gui
use gui::Effect
use gui::dialogs::request
use gui::services
use gui::terminal::{Options, Span, Terminal}
use gui::widgets::find::FindBar

use encodings
use info
use schemes
use settings
use settings::Settings

/// One tab: a terminal and what the window says about it.
#[derive(PartialEq)]
pub struct Tab {
    pub key: String
    pub terminal: Terminal
    /// The title the program set; empty until it sets one.
    pub title: String
    /// The name of the program the tab runs, which names it until the
    /// program sets a title.
    pub name: String
    /// The character set the tab's program reads and writes.
    pub encoding: String
    /// Pinned tabs sit first and show no close button.
    pub pinned: bool
    /// The link under the pointer when it last pressed on the terminal, or
    /// empty, which the context menu's link entries act on.
    pub link: String
    /// The program rang the bell or sent a notification while the tab was
    /// not in front of the user; the tab strip marks it until it is.
    pub attention: bool
    /// A title given on the command line, which names the tab whatever
    /// titles its program sets; empty for none.
    pub fixed_title: String
    /// The tab stays open once its program exits, showing its last screen.
    pub hold: bool
}

impl Tab {
    /// The widget id of the tab's terminal view.
    pub fn view_id(&self) -> String {
        f"term-{self.key}"
    }

    /// What the tab strip, the window title and the Tabs menu call the tab.
    pub fn label(&self) -> String {
        if !self.fixed_title.is_empty() { self.fixed_title } else if !self.title.is_empty() { self.title } else if !self.name.is_empty() { self.name } else { "Terminal" }
    }

    /// Whether a job other than the shell runs in the tab, which closing
    /// it would end.
    pub fn busy(&self) -> bool {
        match self.terminal.snapshot() {
            Ok(shown) => shown.busy
            Err(_) => false
        }
    }

    /// The program that closing the tab would end, named where the system
    /// names it, or None when only the shell runs.
    pub fn running(&self) -> Option<String> {
        let shown = self.terminal.snapshot().ok()?
        if !shown.busy { return None }
        Some(if shown.job.is_empty() { "A program" } else { shown.job })
    }
}

/// One window: its tabs in order and which one it shows.
#[derive(PartialEq)]
pub struct Window {
    pub key: String
    pub tabs: Vec<Tab>
    pub active: String
    /// The tab that was active before `active`, for Last Active Tab, or "".
    pub previous: String
    /// Whether the window covers its display.
    pub fullscreen: bool
    /// Points added to the settings' font size in this window.
    pub zoom: f64
    /// Whether the window has keyboard focus.
    pub focused: bool
    /// The find bar under the window's terminal.
    pub find: FindBar
}

impl Window {
    /// The index of tab `key`, if this window holds it.
    pub fn index_of(&self, key: String) -> Option<i64> {
        self.tabs.iter().position(|t| t.key == key)
    }

    /// The tab the window shows, if it has any.
    pub fn current(&self) -> Option<Tab> {
        let at = self.index_of(self.active)?
        Some(self.tabs[at])
    }

    /// The window title: the label of the tab it shows.
    pub fn title(&self) -> String {
        match self.current() {
            Some(tab) => tab.label()
            None => info::NAME
        }
    }

    /// The id of the window's tab strip.
    pub fn strip_id(&self) -> String {
        f"tabs:{self.key}"
    }
}

/// A window `key` with no tabs yet.
pub fn window(key: String) -> Window {
    Window { key: key, tabs: #[], active: "", previous: "", fullscreen: false, zoom: 0.0, focused: true, find: FindBar::new(f"find-{key}") }
}

/// The match the last search selected, and the tab it is in.
#[derive(PartialEq)]
pub struct Found {
    pub tab: String
    pub span: Span
}

pub struct Model {
    pub windows: Vec<Window>
    pub settings: Settings
    /// Numbers the next tab or window key.
    pub next: i64
    pub found: Option<Found>
    /// The color schemes read from the configuration directory.
    pub user_schemes: Vec<schemes::Entry>
    /// The shortcuts the user set, by command id.
    pub shortcuts: Map<String, Vec<String>>
    /// The installed monospace font families, once listed.
    pub fonts: Option<Vec<String>>
    /// The window waiting for the font list to open Settings, or "".
    pub settings_window: String
    /// A paste held for the user to confirm: the tab and the text.
    pub held_paste: Option<(String, String)>
    /// The scheme a Settings window shows in place of the saved one, after
    /// an import or an edit made while it was open; "" for none.
    pub offered_scheme: String
    /// Set once every window is closing, so the session is saved whole.
    pub quitting: bool
    /// The family an empty font setting shows, read once at start.
    pub desktop_font: String
    /// The scheme Edit Colors is editing.
    pub editing_scheme: String
    /// The tab whose text a Save dialog is choosing a file for, and whether
    /// it saves the selection rather than the whole scrollback.
    pub saving: Option<(String, bool)>
    /// Variables every tab's program gets, as the desktop set those waftty
    /// changed for itself.
    pub program_env: Vec<(String, String)>
}

/// A model with one window, "main", and no tabs yet.
pub fn new(s: Settings) -> Model {
    Model {
        windows: #[window("main")]
        settings: s
        next: 1
        found: None
        user_schemes: #[]
        shortcuts: Map::new()
        fonts: None
        settings_window: ""
        held_paste: None
        offered_scheme: ""
        quitting: false
        desktop_font: ""
        editing_scheme: ""
        saving: None
        program_env: #[]
    }
}

/// The index of window `key`, if it is open.
pub fn window_index(m: Model, key: String) -> Option<i64> {
    m.windows.iter().position(|w| w.key == key)
}

/// The window a tab strip id names.
pub fn strip_window(strip: String) -> String {
    strip.substring(5, strip.byte_len())
}

/// The window holding the tab with terminal `id`, and the tab's index.
pub fn terminal_location(m: Model, id: i64) -> Option<(i64, i64)> {
    let mut w = 0
    while w < m.windows.len() {
        if let Some(t) = m.windows[w].tabs.iter().position(|t| t.terminal.id == id) {
            return Some((w, t))
        }
        w += 1
    }
    None
}

/// The window holding tab `key`, and the tab's index.
pub fn tab_location(m: Model, key: String) -> Option<(i64, i64)> {
    let mut w = 0
    while w < m.windows.len() {
        if let Some(t) = m.windows[w].index_of(key) {
            return Some((w, t))
        }
        w += 1
    }
    None
}

/// Opens a tab running `command` at the end of window `w` and shows it.
pub fn open_tab(m: &mut Model, w: i64, command: gui::terminal::Command) -> Result<(), errors::Error> {
    let s = m.settings
    let terminal = Terminal::open(Options { scrollback: s.scrollback, ..Options::default() })?
    let started = if s.encoding == encodings::DEFAULT { Ok(()) } else { terminal.set_encoding(s.encoding) }
    // Programs that adapt to their terminal, such as image tools, read its name.
    let mut named = command
    named.env.push(("TERM_PROGRAM", info::NAME))
    named.env.push(("TERM_PROGRAM_VERSION", info::VERSION))
    for kv in m.program_env { named.env.push(kv) }
    if let Err(why) = started.and_then(|_| terminal.spawn(named)) {
        terminal.close()
        return Err(errors::wrap(why, f"running {command.program}"))
    }
    let key = f"tab-{m.next}"
    m.next += 1
    m.windows[w].tabs.push(Tab { key: key, terminal: terminal, title: "", name: program_name(command.program), encoding: s.encoding, pinned: false, link: "", attention: false, fixed_title: "", hold: false })
    activate(m, w, key)
    Ok(())
}

/// The name a program's path gives it: "zsh" for /bin/zsh, "pwsh" for
/// C:\Program Files\PowerShell\7\pwsh.exe.
pub fn program_name(program: String) -> String {
    let base = path::file_name(program.replace("\\", "/")).unwrap_or(program)
    if base.to_lowercase().ends_with(".exe") { base.substring(0, base.byte_len() - 4) } else { base }
}

/// The size in interface units of a window showing `columns` by `rows`
/// characters at `points`, with the menu bar and padding around them.
pub fn window_size(s: Settings, points: f64) -> (i64, i64) {
    let px = points * 96.0 / 72.0
    let width = (s.columns as f64 * px * 0.6).ceil() as i64 + 2 * s.padding + if s.scrollbar == "always" { 10 } else { 0 }
    let height = (s.rows as f64 * px * 1.25 * s.line_spacing).ceil() as i64 + 2 * s.padding + if s.menu_bar { 30 } else { 0 }
    (width.max(360), height.max(220))
}

/// Opens a window with one tab running `command`.
pub fn open_window(m: &mut Model, command: gui::terminal::Command) -> Result<(), errors::Error> {
    let key = f"window-{m.next}"
    m.next += 1
    m.windows.push(window(key))
    let w = m.windows.len() - 1
    let width, height = window_size(m.settings, m.settings.font_size)
    gui::perform(Effect::OpenWindow { key: key, title: info::NAME, width: width, height: height })
    if let Err(why) = open_tab(m, w, command) {
        let _ = m.windows.remove(w)
        gui::perform(Effect::CloseWindow(key))
        return Err(why)
    }
    Ok(())
}

/// Shows tab `key` of window `w`, remembering the one it replaces.
pub fn activate(m: &mut Model, w: i64, key: String) {
    let Some(at) = m.windows[w].index_of(key) else { return }
    if m.windows[w].active != key {
        m.windows[w].previous = m.windows[w].active
        m.windows[w].active = key
    }
    m.windows[w].tabs[at].attention = false
    retitle(m, w)
    gui::perform(Effect::FocusIn(m.windows[w].key, m.windows[w].tabs[at].view_id()))
}

/// Brings window `w`'s title up to date with the tab it shows.
pub fn retitle(m: &mut Model, w: i64) {
    gui::perform(Effect::SetTitle(m.windows[w].key, m.windows[w].title()))
}

/// Shows the tab `step` places from the active one, wrapping around.
pub fn cycle(m: &mut Model, w: i64, step: i64) {
    let n = m.windows[w].tabs.len()
    let Some(at) = m.windows[w].index_of(m.windows[w].active) else { return }
    if n < 2 { return }
    activate(m, w, m.windows[w].tabs[(at + step).rem_euclid(n)].key)
}

/// Shows the tab that was active before the current one.
pub fn last_active(m: &mut Model, w: i64) {
    let previous = m.windows[w].previous
    if m.windows[w].index_of(previous).is_some() { activate(m, w, previous) }
}

/// The font size window `w` shows its terminals at: the settings' size
/// plus the window's zoom.
pub fn font_size(m: Model, w: i64) -> f64 {
    m.settings.font_size + m.windows[w].zoom
}

/// Whether zooming `window` by `step` points keeps its font size within
/// the sizes Settings offers.
pub fn can_zoom(s: Settings, window: Window, step: f64) -> bool {
    let size = s.font_size + window.zoom + step
    size >= settings::FONT_SIZE_MIN as f64 && size <= settings::FONT_SIZE_MAX as f64
}

/// Zooms window `w` by `step` points, or back to the settings' size when
/// `step` is 0.
pub fn zoom(m: &mut Model, w: i64, step: f64) {
    if step == 0.0 {
        m.windows[w].zoom = 0.0
    } else if can_zoom(m.settings, m.windows[w], step) {
        m.windows[w].zoom += step
    }
}

/// Makes window `w` cover its display, or gives it back its frame.
pub fn toggle_fullscreen(m: &mut Model, w: i64) {
    m.windows[w].fullscreen = !m.windows[w].fullscreen
    gui::perform(Effect::SetFullscreen(m.windows[w].key, m.windows[w].fullscreen))
}

/// Moves tab `key` of window `w` to index `to`; pinned tabs stay ahead of
/// the others.
pub fn move_tab(m: &mut Model, w: i64, key: String, to: i64) {
    let Some(from) = m.windows[w].index_of(key) else { return }
    let tabs = m.windows[w].tabs
    if to < 0 || to >= tabs.len() || to == from || tabs[from].pinned != tabs[to].pinned { return }
    let tab = tabs[from]
    let _ = m.windows[w].tabs.remove(from)
    let _ = m.windows[w].tabs.insert(to, tab)
}

/// Pins or unpins tab `key` of window `w`, keeping pinned tabs first in the
/// order they were pinned.
pub fn pin(m: &mut Model, w: i64, key: String, pinned: bool) {
    let Some(from) = m.windows[w].index_of(key) else { return }
    let mut tab = m.windows[w].tabs[from]
    if tab.pinned == pinned { return }
    tab.pinned = pinned
    let _ = m.windows[w].tabs.remove(from)
    let at = m.windows[w].tabs.iter().position(|t| !t.pinned).unwrap_or(m.windows[w].tabs.len())
    let _ = m.windows[w].tabs.insert(at, tab)
}

/// Closes tab `t` of window `w` and its program; a window left without
/// tabs closes too.
pub fn close_tab(m: &mut Model, w: i64, t: i64) {
    let tab = m.windows[w].tabs[t]
    tab.terminal.close()
    let _ = m.windows[w].tabs.remove(t)
    if m.windows[w].tabs.is_empty() {
        close_window(m, w)
        return
    }
    if m.windows[w].previous == tab.key { m.windows[w].previous = "" }
    if m.windows[w].active == tab.key {
        let previous = m.windows[w].previous
        let next = if previous.is_empty() { m.windows[w].tabs[t.min(m.windows[w].tabs.len() - 1)].key } else { previous }
        m.windows[w].active = ""
        activate(m, w, next)
        m.windows[w].previous = ""
    } else {
        retitle(m, w)
    }
}

/// Closes window `w` and every program in it; closing the last window
/// quits.
pub fn close_window(m: &mut Model, w: i64) {
    if m.windows.len() == 1 && !m.quitting { save_session(*m) }
    let window = m.windows[w]
    for tab in window.tabs { tab.terminal.close() }
    let _ = m.windows.remove(w)
    if m.windows.is_empty() {
        gui::perform(Effect::Quit)
    } else {
        gui::perform(Effect::CloseWindow(window.key))
    }
}

// The programs closing `tabs` would end, when the settings ask first.
fn would_end(m: Model, tabs: Vec<Tab>) -> Vec<String> {
    if !m.settings.confirm_close { return #[] }
    let mut out = #[]
    for t in tabs {
        if let Some(job) = t.running() && !out.contains(job) { out.push(job) }
    }
    out
}

// "vim is still running", or the programs named together.
fn still_running(jobs: Vec<String>) -> String {
    let named = if jobs.len() == 1 { jobs[0] } else if jobs.len() == 2 { f"{jobs[0]} and {jobs[1]}" } else { f"{jobs[0]}, {jobs[1]} and {jobs.len() - 2} more" }
    f"{named} {if jobs.len() == 1 { "is" } else { "are" }} still running"
}

/// Closes tab `key`, asking first when a program runs in it.
pub fn request_close_tab(m: &mut Model, key: String) {
    let Some(loc) = tab_location(*m, key) else { return }
    let w, t = loc
    let jobs = would_end(*m, #[m.windows[w].tabs[t]])
    if jobs.is_empty() {
        close_tab(m, w, t)
    } else {
        gui::perform(Effect::OpenDialogIn(m.windows[w].key, request::confirm(f"close-tab:{key}", "Close this tab?", f"{still_running(jobs)}. Closing the tab ends it.", "Close Tab", true)))
    }
}

/// Closes window `w`, asking first when a program runs in any of its tabs.
pub fn request_close_window(m: &mut Model, w: i64) {
    let window = m.windows[w]
    let jobs = would_end(*m, window.tabs)
    if jobs.is_empty() {
        close_window(m, w)
    } else {
        gui::perform(Effect::OpenDialogIn(window.key, request::confirm(f"close-window:{window.key}", "Close this window?", f"{still_running(jobs)}. Closing the window ends them.", "Close Window", true)))
    }
}

/// Quits, asking first when a program runs in any tab.
pub fn request_quit(m: &mut Model) {
    let mut tabs = #[]
    for w in m.windows { for t in w.tabs { tabs.push(t) } }
    let jobs = would_end(*m, tabs)
    if jobs.is_empty() {
        close_all(m)
    } else {
        let w = m.windows.iter().position(|w| w.focused).unwrap_or(0)
        gui::perform(Effect::OpenDialogIn(m.windows[w].key, request::confirm("close-all", "Quit waftty?", f"{still_running(jobs)}. Quitting ends them.", "Quit", true)))
    }
}

/// Closes every window and quits.
pub fn close_all(m: &mut Model) {
    save_session(*m)
    m.quitting = true
    while !m.windows.is_empty() { close_window(m, m.windows.len() - 1) }
}

/// Closes the tabs of window `w` that `which` picks from their indexes,
/// leaving pinned tabs, asking first when a program runs in them.
pub fn request_close_tabs(m: &mut Model, w: i64, which: Fn(i64) -> bool) {
    let mut keys = #[]
    let mut i = 0
    while i < m.windows[w].tabs.len() {
        if which(i) && !m.windows[w].tabs[i].pinned { keys.push(m.windows[w].tabs[i].key) }
        i += 1
    }
    let tabs = m.windows[w].tabs.filter(|t| keys.contains(t.key))
    let jobs = would_end(*m, tabs)
    if jobs.is_empty() {
        close_tabs(m, keys)
    } else {
        gui::perform(Effect::OpenDialogIn(m.windows[w].key, request::confirm(f"close-tabs:{keys.join(",")}", "Close these tabs?", f"{still_running(jobs)}. Closing the tabs ends them.", "Close Tabs", true)))
    }
}

/// Closes the tabs `keys` name.
pub fn close_tabs(m: &mut Model, keys: Vec<String>) {
    for key in keys {
        if let Some(loc) = tab_location(*m, key) {
            let w, t = loc
            close_tab(m, w, t)
        }
    }
}

/// One window of a saved session: the folder each of its tabs was in.
#[derive(Default, PartialEq)]
pub struct SavedWindow {
    pub folders: Vec<String>
}

/// The windows open at the last quit, for settings that reopen them.
#[derive(Default, PartialEq)]
pub struct Session {
    pub windows: Vec<SavedWindow>
}

fn session_file() -> String {
    path::join(services::config_dir(info::APP_ID), "session.json")
}

// Saves the windows of `m` and their tabs' folders when the settings
// reopen them; otherwise forgets any saved session.
fn save_session(m: Model) {
    if !m.settings.restore {
        let _ = fs::remove_file(session_file())
        return
    }
    let saved = Session { windows: m.windows.map(|w| SavedWindow { folders: w.tabs.map(|t| t.terminal.cwd().unwrap_or("")) }) }
    let _ = fs::create_dir_all(services::config_dir(info::APP_ID))
    let _ = fs::write(session_file(), json::encode(saved).bytes())
}

/// The session saved at the last quit, if any.
pub fn saved_session() -> Option<Session> {
    let text = fs::read_to_string(session_file()).ok()?
    let saved = json::decode::<Session>(text).ok()?
    if saved.windows.is_empty() { None } else { Some(saved) }
}

/// Shows `why` in window `window` as an error titled `title`.
pub fn report(window: String, title: String, why: errors::Error) {
    gui::perform(Effect::OpenDialogIn(window, request::error("error", title, why.message(), f"{why}", false)))
}

/// `label` as a file name: a character some file system refuses becomes `-`.
pub fn file_name(label: String) -> String {
    let refused = "/\\:*?\"<>|"
    let mut out = String::with_capacity(label.byte_len())
    for c in label {
        if c.is_control() || refused.contains(c.to_string()) { out += "-" } else { out += c.to_string() }
    }
    let name = out.trim()
    if name.is_empty() { "terminal" } else { name }
}

/// The program a new tab runs under the current settings.
pub fn shell(m: Model) -> gui::terminal::Command {
    settings::command(m.settings)
}

/// The font window terminals show: the family the settings name, else the
/// desktop's monospace font, else the bundled one.
pub fn font(m: Model) -> String {
    if m.settings.font.is_empty() { m.desktop_font } else { m.settings.font }
}

/// The program a tab opened from window `w` runs: in the directory of the
/// tab the window shows, when the settings ask for that and it is known.
pub fn shell_here(m: Model, w: i64) -> gui::terminal::Command {
    let command = shell(m)
    if m.settings.new_tabs != "current" { return command }
    let Some(tab) = m.windows[w].current() else { return command }
    match tab.terminal.cwd() {
        Ok(dir) if !dir.is_empty() => gui::terminal::Command { cwd: dir, ..command }
        _ => command
    }
}

/// The color scheme the settings name, among the built-in and user ones.
pub fn scheme(m: Model) -> schemes::Entry {
    schemes::find(schemes::all(m.user_schemes), m.settings.scheme)
}

#[cfg(test)]
mod tests {
    #[test]
    fn a_label_becomes_a_file_name_without_the_characters_file_systems_refuse() {
        assert_eq(super::file_name("vim: a/b.txt"), "vim- a-b.txt")
        assert_eq(super::file_name("  "), "terminal")
    }

    use std::encoding::json

    use settings::Settings

    use super::{SavedWindow, Session}

    #[test]
    fn zoom_stops_at_the_font_sizes_settings_offers_and_normal_size_undoes_it() {
        let mut m = super::new(Settings { font_size: 46.0, ..Settings::default() })
        super::zoom(&mut m, 0, 1.0)
        super::zoom(&mut m, 0, 1.0)
        assert_eq(super::font_size(m, 0), 48.0)
        super::zoom(&mut m, 0, 1.0)
        assert_eq(super::font_size(m, 0), 48.0)
        assert(!super::can_zoom(m.settings, m.windows[0], 1.0))
        super::zoom(&mut m, 0, 0.0)
        assert_eq(super::font_size(m, 0), 46.0)
        m.settings.font_size = 6.0
        super::zoom(&mut m, 0, -1.0)
        assert_eq(super::font_size(m, 0), 6.0)
    }

    #[test]
    fn a_tab_is_named_for_its_program_until_the_program_titles_it() {
        assert_eq(super::program_name("/bin/zsh"), "zsh")
        assert_eq(super::program_name("C:\\Program Files\\PowerShell\\7\\pwsh.exe"), "pwsh")
        assert_eq(super::program_name("fish"), "fish")
    }

    #[test]
    fn a_saved_session_reads_back_as_its_windows_and_folders() {
        let saved = Session { windows: #[SavedWindow { folders: #["/tmp", ""] }, SavedWindow { folders: #["/home"] }] }
        let Ok(back) = json::decode::<Session>(json::encode(saved)) else { panic("the session did not read back") }
        assert_eq(back, saved)
    }

    #[test]
    fn a_close_prompt_names_what_it_would_end() {
        assert_eq(super::still_running(#["vim"]), "vim is still running")
        assert_eq(super::still_running(#["vim", "ssh"]), "vim and ssh are still running")
        assert_eq(super::still_running(#["vim", "ssh", "top", "less"]), "vim, ssh and 2 more are still running")
    }
}
