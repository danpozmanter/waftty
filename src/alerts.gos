// Alerts for a tab that is not in front: a command that ran a while has
// finished, or an agent needs the user. Only the agent's own word counts:
// Claude Code's record of its state, and the notifications and bells agents
// send through the terminal. An agent that ends its turn has not asked for
// anything, so that alone does not alert. The records are read when the
// folder holding them changes, which the toolkit watches on a thread of its
// own while a tab runs Claude Code, so an idle agent costs nothing.

/// The id of the watch on the folder of Claude Code's records
/// (`Effect::WatchFolder`).
pub const RECORDS: String = "agents:records"

/// What is known of one running agent's state.
#[derive(Default, PartialEq)]
pub struct Watch {
    /// The agent's process, once its record is found; 0 until then.
    pub pid: i64
    /// Its state as last read: "busy", "shell", "idle" or "waiting".
    pub state: String
}

/// What one look at an agent's state means for its tab.
#[derive(Default, PartialEq)]
pub struct Change {
    /// The agent asks the user for something: what, as its alert says.
    pub alert: Option<String>
    /// The agent is not working, so its session record may have changed.
    pub stopped: bool
}

/// `watch` once the agent says its state is `state`, waiting for
/// `waiting_for` when it asks for an answer. "busy" is working; "shell" has
/// ended its turn while commands it started run on; "idle" has ended its turn;
/// "waiting" asks the user for an answer, such as a permission, and alerts.
pub fn moved(watch: Watch, state: String, waiting_for: String) -> (Watch, Change) {
    if state == watch.state { return (watch, Change::default()) }
    let stopped = state != "busy"
    let alert = if state == "waiting" { Some(if waiting_for.is_empty() { "an answer" } else { waiting_for }) } else { None }
    (Watch { state: state, ..watch }, Change { alert: alert, stopped: stopped })
}

/// Whether a job that came to the front at `since` and left at `now`, both
/// in milliseconds since the Unix epoch, ran at least `after_ms`.
pub fn ran_long(since: i64, now: i64, after_ms: i64) -> bool {
    since > 0 && now - since >= after_ms
}

/// How long `ms` milliseconds is, as an alert says it: "45s", "2m 05s",
/// "1h 03m".
pub fn duration_text(ms: i64) -> String {
    let s = ms.max(0) / 1000
    if s < 60 { return f"{s}s" }
    if s < 3600 { return f"{s / 60}m {s % 60:02}s" }
    f"{s / 3600}h {s / 60 % 60:02}m"
}

#[cfg(test)]
mod tests {
    use super::{Change, Watch, moved}

    #[test]
    fn a_job_counts_as_long_from_the_threshold_on() {
        assert(super::ran_long(1_000, 11_000, 10_000))
        assert(!super::ran_long(1_000, 10_999, 10_000))
        assert(!super::ran_long(0, 50_000, 10_000))
    }

    #[test]
    fn an_agent_alerts_only_when_it_asks_for_an_answer() {
        let busy, began = moved(Watch::default(), "busy", "")
        assert_eq(began, Change::default())
        let asking, asked = moved(busy, "waiting", "permission prompt")
        assert_eq(asked, Change { alert: Some("permission prompt"), stopped: true })
        // Read again unchanged, it does not alert twice.
        assert_eq(moved(asking, "waiting", "permission prompt").1, Change::default())
        assert_eq(moved(Watch::default(), "waiting", "").1, Change { alert: Some("an answer"), stopped: true })
    }

    #[test]
    fn an_agent_ending_its_turn_does_not_alert() {
        let busy = moved(Watch::default(), "busy", "").0
        assert_eq(moved(busy, "idle", "").1, Change { alert: None, stopped: true })
        let running_on = moved(busy, "shell", "")
        assert_eq(running_on.1, Change { alert: None, stopped: true })
        assert_eq(moved(running_on.0, "idle", "").1, Change { alert: None, stopped: true })
        // A turn ended before its start was seen is still its end.
        assert_eq(moved(Watch::default(), "idle", "").1, Change { alert: None, stopped: true })
    }

    #[test]
    fn durations_read_in_seconds_minutes_or_hours() {
        assert_eq(super::duration_text(45_400), "45s")
        assert_eq(super::duration_text(125_000), "2m 05s")
        assert_eq(super::duration_text(3_780_000), "1h 03m")
    }
}
