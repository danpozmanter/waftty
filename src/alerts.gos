// Alerts for a tab that is not in front: a command that ran a while has
// finished, or a program needs the user. Only the program's own word counts:
// the status it reports through the terminal (OSC 7501, the Program Status
// Protocol, which Codex and Claude Code speak), Claude Code's record of its
// state, and the notifications and bells programs send. A program that ends
// its turn has not asked for anything, so that alone does not alert. Claude
// Code's records are read when the folder holding them changes, which the
// toolkit watches on a thread of its own while a tab runs Claude Code, so an
// idle agent costs nothing.

use gui::terminal::Status

/// The id of the watch on the folder of Claude Code's records
/// (`Effect::WatchFolder`).
pub const RECORDS: String = "agents:records"

/// What is known of one running agent's state.
#[derive(Default, PartialEq)]
pub struct Watch {
    /// The agent's process, once its record is found; 0 until then.
    pub pid: i64
    /// Its state as last read: "busy", "shell", "idle" or "waiting".
    pub state: String
}

/// What one look at an agent's state means for its tab.
#[derive(Default, PartialEq)]
pub struct Change {
    /// The agent asks the user for something: what, as its alert says.
    pub alert: Option<String>
    /// The agent is not working, so its session record may have changed.
    pub stopped: bool
}

/// `watch` once the agent says its state is `state`, waiting for
/// `waiting_for` when it asks for an answer. "busy" is working; "shell" has
/// ended its turn while commands it started run on; "idle" has ended its turn;
/// "waiting" asks the user for an answer, such as a permission, and alerts.
pub fn moved(watch: Watch, state: String, waiting_for: String) -> (Watch, Change) {
    if state == watch.state { return (watch, Change::default()) }
    let stopped = state != "busy"
    let alert = if state == "waiting" { Some(if waiting_for.is_empty() { "an answer" } else { waiting_for }) } else { None }
    (Watch { state: state, ..watch }, Change { alert: alert, stopped: stopped })
}

/// The records a tab's program reported about itself and its tasks (OSC
/// 7501), each one's id and state, least recently updated first.
#[derive(Default, PartialEq)]
pub struct Reported {
    pub records: Vec<(String, String)>
    /// The program reports its status, so its reports alone say when it
    /// needs the user.
    pub reporting: bool
}

/// The most records a tab keeps; past it the least recently updated goes.
pub const RECORDS_LIMIT: i64 = 64

/// `held` once the tab's program reports `status`, and what that means for
/// the tab. A record that comes to be `blocked` asks the user for something
/// and alerts; one reported again as blocked does not alert twice.
pub fn reported(held: Reported, status: Status) -> (Reported, Change) {
    let mut records = held.records
    if status.state == "clear" {
        let under = f"{status.id}/"
        records = records.filter(|r| !status.id.is_empty() && r.0 != status.id && !r.0.starts_with(under))
        return (Reported { records: records, reporting: true }, Change::default())
    }
    let before = records.iter().find(|r| r.0 == status.id).map(|r| r.1).unwrap_or("")
    records = records.filter(|r| r.0 != status.id)
    records.push((status.id, status.state))
    while records.len() > RECORDS_LIMIT { let _ = records.remove(0) }
    let alert = if status.state == "blocked" && before != "blocked" { Some(waited_for(status)) } else { None }
    (Reported { records: records, reporting: true }, Change { alert: alert, stopped: status.state != "working" })
}

// What a blocked program waits for, as its alert says it: the program's own
// words when it gave them, else what its kind of wait is.
fn waited_for(status: Status) -> String {
    if !status.msg.is_empty() { return status.msg }
    match status.kind {
        "permission" => "permission prompt"
        "question" => "a question"
        "auth" => "sign-in"
        _ => "input needed"
    }
}

/// Whether a job that came to the front at `since` and left at `now`, both
/// in milliseconds since the Unix epoch, ran at least `after_ms`.
pub fn ran_long(since: i64, now: i64, after_ms: i64) -> bool {
    since > 0 && now - since >= after_ms
}

/// How long `ms` milliseconds is, as an alert says it: "45s", "2m 05s",
/// "1h 03m".
pub fn duration_text(ms: i64) -> String {
    let s = ms.max(0) / 1000
    if s < 60 { return f"{s}s" }
    if s < 3600 { return f"{s / 60}m {s % 60:02}s" }
    f"{s / 3600}h {s / 60 % 60:02}m"
}

#[cfg(test)]
mod tests {
    use gui::terminal::Status
    use super::{Change, Reported, Watch, moved, reported}

    #[test]
    fn a_job_counts_as_long_from_the_threshold_on() {
        assert(super::ran_long(1_000, 11_000, 10_000))
        assert(!super::ran_long(1_000, 10_999, 10_000))
        assert(!super::ran_long(0, 50_000, 10_000))
    }

    #[test]
    fn an_agent_alerts_only_when_it_asks_for_an_answer() {
        let busy, began = moved(Watch::default(), "busy", "")
        assert_eq(began, Change::default())
        let asking, asked = moved(busy, "waiting", "permission prompt")
        assert_eq(asked, Change { alert: Some("permission prompt"), stopped: true })
        // Read again unchanged, it does not alert twice.
        assert_eq(moved(asking, "waiting", "permission prompt").1, Change::default())
        assert_eq(moved(Watch::default(), "waiting", "").1, Change { alert: Some("an answer"), stopped: true })
    }

    #[test]
    fn an_agent_ending_its_turn_does_not_alert() {
        let busy = moved(Watch::default(), "busy", "").0
        assert_eq(moved(busy, "idle", "").1, Change { alert: None, stopped: true })
        let running_on = moved(busy, "shell", "")
        assert_eq(running_on.1, Change { alert: None, stopped: true })
        assert_eq(moved(running_on.0, "idle", "").1, Change { alert: None, stopped: true })
        // A turn ended before its start was seen is still its end.
        assert_eq(moved(Watch::default(), "idle", "").1, Change { alert: None, stopped: true })
    }

    fn status(id: String, state: String, kind: String, msg: String) -> Status {
        Status { id: id, state: state, app: "codex", kind: kind, progress: -1, title: "", msg: msg }
    }

    #[test]
    fn a_program_alerts_when_it_comes_to_wait_for_the_user() {
        let working, began = reported(Reported::default(), status("", "working", "", ""))
        assert_eq(began, Change::default())
        assert(working.reporting)
        let blocked, asked = reported(working, status("", "blocked", "permission", ""))
        assert_eq(asked, Change { alert: Some("permission prompt"), stopped: true })
        // Reported again while it waits, it does not alert twice.
        assert_eq(reported(blocked, status("", "blocked", "permission", "")).1.alert, None)
        let why = reported(Reported::default(), status("", "blocked", "question", "Which branch?")).1
        assert_eq(why.alert, Some("Which branch?"))
        assert_eq(reported(Reported::default(), status("", "blocked", "auth", "")).1.alert, Some("sign-in"))
        assert_eq(reported(Reported::default(), status("", "blocked", "", "")).1.alert, Some("input needed"))
    }

    #[test]
    fn a_program_finishing_or_failing_does_not_alert() {
        let working = reported(Reported::default(), status("", "working", "", "")).0
        for end in ["idle", "done", "error"] {
            assert_eq(reported(working, status("", end, "", "")).1, Change { alert: None, stopped: true })
        }
    }

    #[test]
    fn each_task_keeps_a_record_of_its_own_until_cleared() {
        let mut held = Reported::default()
        held = reported(held, status("build", "blocked", "permission", "")).0
        // Another task coming to wait alerts for itself.
        let other = reported(held, status("build/test", "blocked", "question", ""))
        assert_eq(other.1.alert, Some("a question"))
        held = other.0
        assert_eq(held.records.len(), 2)
        // Clearing a task clears those under it, and a clear without an id
        // clears every record.
        held = reported(held, status("build", "clear", "", "")).0
        assert(held.records.is_empty())
        held = reported(held, status("", "idle", "", "")).0
        held = reported(held, status("x", "idle", "", "")).0
        assert(reported(held, status("", "clear", "", "")).0.records.is_empty())
        // A program with many tasks keeps the latest of them.
        let mut many = Reported::default()
        for n in 0..super::RECORDS_LIMIT + 5 { many = reported(many, status(f"task{n}", "working", "", "")).0 }
        assert_eq(many.records.len(), super::RECORDS_LIMIT)
        assert_eq(many.records[0].0, "task5")
    }

    #[test]
    fn durations_read_in_seconds_minutes_or_hours() {
        assert_eq(super::duration_text(45_400), "45s")
        assert_eq(super::duration_text(125_000), "2m 05s")
        assert_eq(super::duration_text(3_780_000), "1h 03m")
    }
}
