// waftty: a tabbed terminal emulator. It runs the user's shell in each tab,
// or with `-e program [args...]` that program in the first one. `--fixture`
// runs the scripted journey the checks use instead of opening a window.

use std::{env, errors, process}

use windowing::system

use application
use application::FirstTab
use cli
use console
use fixture
use info
use input_method
use model
use portable
use settings
use settings::Settings
use shell_integration

fn main() -> Result<(), errors::Error> {
    let invoked = cli::invocation(env::args())
    match invoked {
        Ok(cli::Invocation::Open(_)) => {}
        _ => console::attach()
    }
    let launch = match invoked {
        Ok(cli::Invocation::Version) => {
            println(f"{info::NAME} {info::VERSION}")
            return Ok(())
        }
        Ok(cli::Invocation::Help) => {
            print(cli::USAGE)
            return Ok(())
        }
        Ok(cli::Invocation::Fixture) => return fixture::journey()
        Ok(cli::Invocation::ShellIntegration(shell)) => {
            match shell_integration::script(shell) {
                Some(script) => print(script)
                None => {
                    eprintln(f"{info::NAME}: no shell integration for {shell}; there is for {shell_integration::SHELLS}")
                    process::exit(2)
                }
            }
            return Ok(())
        }
        Ok(cli::Invocation::Open(launch)) => launch
        Err(why) => {
            eprint(f"{info::NAME}: {why}\n{cli::USAGE}")
            process::exit(2)
        }
    }
    // The tabs' programs belong to this process, not to the service that
    // launched it, which may stop or restart on its own.
    if let Err(why) = system::own_scope(info::APP_ID) { eprintln(f"{info::NAME}: tabs stay in the launcher's service: {why}") }
    portable::enable()
    let s = match settings::load() {
        Ok(s) => s
        Err(why) => {
            eprintln(f"{info::NAME}: ignoring unreadable settings: {why}")
            Settings::default()
        }
    }
    // A session comes back when the command line asked for no program and no
    // folder; its first window's first tab opens in its folder.
    let restore = launch.program.is_none() && launch.directory.is_empty() && s.restore && !launch.quick
    let mut first = cli::first_command(launch, s, env::current_dir().unwrap_or(""))
    if restore && let Some(saved) = model::saved_session() && !saved.windows[0].folders.is_empty() && !saved.windows[0].folders[0].is_empty() {
        first.cwd = saved.windows[0].folders[0]
    }
    // The input method is chosen as the window system starts, so before it.
    let program_env = input_method::prepare(s.input_method)
    // A `--single-instance` launch hands its whole command line over, so the
    // running waftty reads it as this process would have.
    let instance = if launch.single_instance && !launch.quick { Some(env::args()) } else { None }
    let first_tab = FirstTab { title: launch.title, hold: launch.hold, quick: launch.quick, quick_position: launch.quick_position }
    application::app(s, first, first_tab, restore, program_env, instance).run()
}
