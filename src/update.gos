// Folds each message into the model: commands from menus and shortcuts,
// the tab strip's requests, what the terminals report, window closing, and
// the Find, Settings, Edit Colors, About and confirmation dialogs.

use std::{errors, fs, os, path, runtime}

use gui
use gui::{Effect, Outcome, UiMsg}
use gui::dialogs::request
use gui::dialogs::request::DialogRequest
use gui::services
use gui::services::desktop::Urgency
use gui::terminal::Event
use windowing

use cli
use commands
use drop_down
use info
use model
use model::Model
use prompts
use recent
use releases
use releases::Release
use schemes
use search
use search::Step
use settings
use shortcuts
use view

/// The model after `msg`.
pub fn update(m: Model, msg: UiMsg) -> Model {
    let mut n = m
    if search::message(&mut n, msg) { return n }
    match msg {
        UiMsg::Command(id) => command(&mut n, "main", id)
        UiMsg::Chosen(id, dir) if commands::recent_window_of(id).is_some() => {
            let window = commands::recent_window_of(id).unwrap_or("")
            if let Some(w) = model::window_index(n, window) {
                close_overlays(&mut n, w)
                go_to(&mut n, w, dir)
            }
        }
        UiMsg::WindowCommand(window, id) => command(&mut n, window, id)
        UiMsg::Terminal(id, event) => terminal_event(&mut n, id, event)
        UiMsg::TabSelected(strip, key) => {
            if let Some(w) = model::window_index(n, model::strip_window(strip)) { model::activate(&mut n, w, key) }
        }
        UiMsg::Reordered(strip, key, to) => {
            if let Some(w) = model::window_index(n, model::strip_window(strip)) {
                model::move_tab(&mut n, w, key, to)
                model::retitle(&mut n, w)
            }
        }
        UiMsg::TabAction(strip, key, action) => tab_action(&mut n, model::strip_window(strip), key, action)
        UiMsg::TabMoved(strip, key, target, at) => {
            if let Some(from) = model::window_index(n, model::strip_window(strip)) &&
                let Some(to) = model::window_index(n, model::strip_window(target)) {
                model::transfer_tab(&mut n, from, key, to, at)
            }
        }
        // Dropped on a window showing no strip: it goes last among that window's tabs.
        UiMsg::TabMovedToWindow(strip, key, window) => {
            if let Some(from) = model::window_index(n, model::strip_window(strip)) &&
                let Some(to) = model::window_index(n, window) {
                model::transfer_tab(&mut n, from, key, to, i64::MAX)
            }
        }
        UiMsg::CommandLine(directory, arguments) => launched(&mut n, directory, arguments)
        UiMsg::TabDetached(strip, key, x, y) => {
            if let Some(from) = model::window_index(n, model::strip_window(strip)) { model::detach_tab(&mut n, from, key, Some((x, y))) }
        }
        UiMsg::CloseRequested(window) => {
            if let Some(w) = model::window_index(n, window) { model::request_close_window(&mut n, w) }
        }
        UiMsg::WindowFocusChanged(window, focused) => {
            if let Some(w) = model::window_index(n, window) {
                n.windows[w].focused = focused
                if focused && n.windows[w].key == "main" { n.drop_down_hidden = false }
                if focused && let Some(t) = n.windows[w].index_of(n.windows[w].active) { n.windows[w].tabs[t].attention = false }
            }
        }
        UiMsg::QuitRequested => model::request_quit(&mut n)
        UiMsg::SplitMoved(id, ratio) => {
            if let Some(found) = view::split_of(id) {
                let window, leader, path = found
                if let Some(w) = model::window_index(n, window) { model::resize_split(&mut n, w, leader, path, ratio) }
            }
        }
        UiMsg::FontsLoaded(owner, records) => {
            if owner == "settings" {
                let mut families: Vec<String> = #[]
                for r in records {
                    if r.monospace && !families.contains(r.family) { families.push(r.family) }
                }
                families.sort()
                n.fonts = Some(families)
                let window = n.settings_window
                n.settings_window = ""
                if model::window_index(n, window).is_some() { open_settings(&mut n, window) }
            }
        }
        UiMsg::DialogPreview(id, Outcome::Action(action)) if id == "settings" => settings_action(&mut n, action)
        UiMsg::Dialog(id, outcome) | UiMsg::DialogApplied(id, outcome) => dialog(&mut n, id, outcome)
        UiMsg::WorkFinished(owner, _, _, outcome) if owner == releases::OWNER => {
            if let Some(release) = releases::answer(outcome) { release_checked(&mut n, release) }
        }
        UiMsg::Hotkey(id) if id == drop_down::HOTKEY && n.drop_down => drop_down::toggle(&mut n)
        UiMsg::DockResized(window, width, height) if n.drop_down && window == "main" => drop_down::resized(&mut n, width, height)
        UiMsg::Task(id, gui::TaskOutcome::Failed(why)) if id == drop_down::HOTKEY => {
            model::report(n.windows[0].key, "Couldn't set the quick terminal's shortcut", errors::new(f"{why}. Choose another in Settings > Quick Terminal."))
        }
        _ => ()
    }
    n
}

fn dialog(m: &mut Model, id: String, outcome: Outcome) {
    let accepted = outcome == Outcome::Action("accept")
    if id == "settings" {
        if let Outcome::Values(values) = outcome { apply_settings(m, values) }
        if outcome != Outcome::Action("apply") { m.offered_scheme = "" }
    } else if id == "scheme-editor" && let Outcome::Values(values) = outcome {
        // A user scheme edited under its own name keeps its file.
        let mut e = schemes::edited(values)
        let original = schemes::find(schemes::all(m.user_schemes), m.editing_scheme)
        if original.id == m.editing_scheme && original.id.starts_with("user:") && original.name == e.name { e.id = original.id }
        save_scheme(m, e)
    } else if id == "export-scheme" && let Outcome::Paths(files) = outcome && !files.is_empty() {
        let e = schemes::find(schemes::all(m.user_schemes), m.editing_scheme)
        if let Err(why) = fs::write(files[0], schemes::text(e).bytes()) { model::report(m.windows[0].key, "The scheme couldn't be exported", why) }
    } else if id == "import-scheme" && let Outcome::Paths(files) = outcome && !files.is_empty() {
        match schemes::import(files[0]) {
            Ok(e) => save_scheme(m, e)
            Err(why) => model::report(m.windows[0].key, "The scheme could not be imported", why)
        }
    } else if id == "save-text" {
        let saving = m.saving
        m.saving = None
        if let Outcome::Paths(files) = outcome && !files.is_empty() && let Some(asked) = saving {
            let key, selection = asked
            if let Some(loc) = model::tab_location(*m, key) {
                let w, t = loc
                if let Err(why) = m.windows[w].tabs[t].terminal.save_text(files[0], selection) {
                    model::report(m.windows[w].key, "Couldn't save the text", why)
                }
            }
        }
    } else if accepted && id.starts_with("paste:") {
        if let Some(held) = m.held_paste {
            let key, text = held
            if let Some(loc) = model::tab_location(*m, key) {
                let w, t = loc
                if let Err(why) = m.windows[w].tabs[t].terminal.paste(text) {
                    model::report(m.windows[w].key, "Couldn't paste", why)
                }
            }
        }
        m.held_paste = None
    } else if id.starts_with("paste:") {
        m.held_paste = None
    } else if accepted && id.starts_with("close-tab:") {
        if let Some(loc) = model::tab_location(*m, id.substring(10, id.byte_len())) {
            let w, t = loc
            model::close_tab(m, w, t)
        }
    } else if accepted && id.starts_with("close-tabs:") {
        model::close_tabs(m, id.substring(11, id.byte_len()).split(","))
    } else if accepted && id.starts_with("close-window:") {
        if let Some(w) = model::window_index(*m, id.substring(13, id.byte_len())) { model::close_window(m, w) }
    } else if accepted && id == "close-all" {
        model::close_all(m)
    } else if accepted && id.starts_with(UPDATE_DIALOG) {
        gui::perform(Effect::OpenUrl(id.substring(UPDATE_DIALOG.byte_len(), id.byte_len())))
    }
}

// The confirmation that offers a newer release; its id carries the page.
const UPDATE_DIALOG: String = "update:"

// Shows the answer to Check for Updates in the window that asked, or the
// first window when that one has closed.
fn release_checked(m: &mut Model, release: Release) {
    let asked = m.checking_window
    m.checking_window = ""
    let window = if model::window_index(*m, asked).is_some() { asked } else if !m.windows.is_empty() { m.windows[0].key } else { return }
    let shown = match release {
        Release::Newer { version, page } => request::confirm(f"{UPDATE_DIALOG}{page}", "Update Available", f"waftty {version} is available. This is waftty {info::VERSION}.", "Download", false)
        Release::Current => request::info("update", "No Update Available", f"waftty {info::VERSION} is the latest version.")
        Release::Failed(why) => request::error("update", "Couldn't Check for Updates", why, why, false)
    }
    gui::perform(Effect::OpenDialogIn(window, shown))
}

// Runs command `id` in window `window`.
// Shows the command palette over window `w`'s terminal, its search field
// focused.
fn open_palette(m: &mut Model, w: i64) {
    m.windows[w].recent = false
    m.windows[w].palette = true
    gui::perform(Effect::FocusInWindow(m.windows[w].key, commands::PALETTE_FIELD))
}

// Shows Recent Directories over window `w`'s terminal, its search field
// focused.
fn open_recent(m: &mut Model, w: i64) {
    m.windows[w].palette = false
    m.windows[w].recent = true
    gui::perform(Effect::FocusInWindow(m.windows[w].key, commands::recent_field(m.windows[w].key)))
}

// Hides the palette and Recent Directories over window `w`'s terminal and
// gives the terminal back its focus.
fn close_overlays(m: &mut Model, w: i64) {
    m.windows[w].palette = false
    m.windows[w].recent = false
    if let Some(tab) = m.windows[w].current() { gui::perform(Effect::FocusInWindow(m.windows[w].key, tab.view_id())) }
}

// Moves window `w`'s terminal to `dir`: a cd typed at an idle shell's
// prompt, or else a new tab there.
fn go_to(m: &mut Model, w: i64, dir: String) {
    let window = m.windows[w].key
    if let Some(tab) = m.windows[w].current() && !tab.busy() && let Some(text) = recent::cd_input(tab.name, dir) {
        if let Err(why) = tab.terminal.input(text) { model::report(window, "Couldn't change the directory", why) }
        return
    }
    let command = gui::terminal::Command { cwd: dir, ..model::shell(*m) }
    if let Err(why) = model::open_tab(m, w, command) { model::report(window, "Couldn't open a tab", why) }
}

fn command(m: &mut Model, window: String, id: String) {
    let Some(w) = model::window_index(*m, window) else { return }
    if let Some(number) = commands::signal_of(id) {
        return send_signal(m, w, number)
    }
    if let Some(label) = commands::encoding_of(id) {
        return set_encoding(m, w, label)
    }
    if let Some(key) = commands::shown_tab_of(id) {
        return model::activate(m, w, key)
    }
    if let Some(n) = commands::number_of(id) {
        let tabs = m.windows[w].strip()
        if tabs.is_empty() { return }
        let at = if n == 9 { tabs.len() - 1 } else { n - 1 }
        if at < tabs.len() { model::activate(m, w, tabs[at].key) }
        return
    }
    // The palette and Recent Directories close for any command they do not
    // open, the palette's own choice included.
    if (m.windows[w].palette && id != commands::COMMAND_PALETTE) || (m.windows[w].recent && id != commands::RECENT_DIRS) { close_overlays(m, w) }
    let tab = m.windows[w].current()
    match id {
        commands::COMMAND_PALETTE => if m.windows[w].palette { close_overlays(m, w) } else { open_palette(m, w) }
        commands::RECENT_DIRS => if m.windows[w].recent { close_overlays(m, w) } else { open_recent(m, w) }
        commands::CLEAR_RECENT => {
            m.recent_dirs = #[]
            recent::clear()
            gui::perform(Effect::Announce("Recent directories cleared"))
        }
        commands::NEW_PRIVATE_TAB => {
            if let Err(why) = model::open_tab(m, w, model::shell_here(*m, w), private: true) { model::report(window, "Couldn't open a private tab", why) }
        }
        commands::NEW_PRIVATE_WINDOW => {
            if let Err(why) = model::open_window(m, model::shell_here(*m, w), private: true) { model::report(window, "Couldn't open a private window", why) }
        }
        commands::NEW_TAB => {
            if let Err(why) = model::open_tab(m, w, model::shell_here(*m, w)) { model::report(window, "Couldn't open a tab", why) }
        }
        commands::NEW_WINDOW => {
            if let Err(why) = model::open_window(m, model::shell_here(*m, w)) { model::report(window, "Couldn't open a window", why) }
        }
        commands::CLOSE_TAB => {
            if let Some(t) = tab && !t.pinned { model::request_close_tab(m, t.key) }
        }
        commands::CLOSE_WINDOW => model::request_close_window(m, w)
        commands::QUIT => model::request_quit(m)
        commands::OPEN_LINK => {
            if let Some(t) = tab && !t.link.is_empty() { gui::perform(Effect::OpenUrl(t.link)) }
        }
        commands::COPY_LINK => {
            if let Some(t) = tab && !t.link.is_empty() { gui::perform(Effect::SetClipboard(t.link)) }
        }
        commands::COPY_EMAIL => {
            if let Some(t) = tab && let Some(address) = commands::email_of(t.link) { gui::perform(Effect::SetClipboard(address)) }
        }
        commands::SETTINGS => {
            if m.fonts.is_some() {
                open_settings(m, window)
            } else {
                // The font list comes from the installed fonts, read off the
                // UI thread; the window opens once it arrives.
                m.settings_window = window
                gui::perform(Effect::LoadFonts("settings"))
            }
        }
        commands::FULLSCREEN => model::toggle_fullscreen(m, w)
        commands::ZOOM_IN => model::zoom(m, w, commands::ZOOM_STEP)
        commands::ZOOM_OUT => model::zoom(m, w, -commands::ZOOM_STEP)
        commands::NORMAL_SIZE => model::zoom(m, w, 0.0)
        commands::MENU_BAR => {
            let mut chosen = m.settings
            chosen.menu_bar = !chosen.menu_bar
            store_settings(m, chosen)
        }
        commands::RESET_WINDOW_SIZE => {
            let width, height = model::window_size(m.settings, model::font_size(*m, w))
            gui::perform(Effect::SetWindowSize(window, width, height))
        }
        commands::FIND => search::open(m, w)
        commands::FIND_NEXT => search::run(m, window, Step::Next)
        commands::FIND_PREVIOUS => search::run(m, window, Step::Previous)
        commands::FIND_CLOSE => search::close(m, w)
        commands::PREVIOUS_PROMPT | commands::NEXT_PROMPT => {
            if let Some(t) = tab && let Err(why) = prompts::jump(t.terminal, id == commands::PREVIOUS_PROMPT) {
                model::report(window, "Couldn't move to the prompt", why)
            }
        }
        commands::SELECT_OUTPUT => {
            if let Some(t) = tab {
                match prompts::select_output(t.terminal) {
                    Ok(true) => ()
                    Ok(false) => gui::perform(Effect::Announce("Command output can't be found: shell integration is off. See Shell Integration in the guide."))
                    Err(why) => model::report(window, "Couldn't select the output", why)
                }
            }
        }
        commands::SCROLL_PAGE_UP | commands::SCROLL_PAGE_DOWN | commands::SCROLL_TOP | commands::SCROLL_BOTTOM => {
            if let Some(t) = tab && let Ok(shown) = t.terminal.snapshot() {
                let rows = match id {
                    commands::SCROLL_PAGE_UP => shown.rows
                    commands::SCROLL_PAGE_DOWN => -shown.rows
                    commands::SCROLL_TOP => shown.history
                    _ => -shown.scrolled
                }
                let _ = t.terminal.scroll(rows)
            }
        }
        commands::COPY_MODE => {
            if let Some(t) = tab && let Err(why) = t.terminal.copy_mode() {
                model::report(window, "Couldn't start copy mode", why)
            }
        }
        commands::OPEN_LINK_HINT | commands::COPY_LINK_HINT => {
            if let Some(t) = tab {
                match t.terminal.hints(id == commands::COPY_LINK_HINT) {
                    Ok(0) => gui::perform(Effect::Announce("There are no links on the screen"))
                    Ok(_) => ()
                    Err(why) => model::report(window, "Couldn't label the links", why)
                }
            }
        }
        commands::SAVE_SCROLLBACK | commands::SAVE_SELECTION => {
            if let Some(t) = tab {
                let selection = id == commands::SAVE_SELECTION
                m.saving = Some((t.key, selection))
                let title = if selection { "Save Selection" } else { "Save Scrollback" }
                let filters = #[request::FileFilter { name: "Text", patterns: #["*.txt"] }]
                gui::perform(Effect::OpenDialogIn(window, request::save_file("save-text", title, f"{model::file_name(t.label())}.txt", filters)))
            }
        }
        commands::EDIT_SCROLLBACK => {
            if let Some(t) = tab {
                let saved = fs::temp_dir("waftty-").and_then(|dir| {
                    let file = path::join(dir, f"{model::file_name(t.label())}.txt")
                    t.terminal.save_text(file, false).map(|_| file)
                })
                match saved {
                    Ok(file) => open_path(m, w, file, 0, 0)
                    Err(why) => model::report(window, "Couldn't open the scrollback in the editor", why)
                }
            }
        }
        commands::CLEAR_SCROLLBACK => {
            if let Some(t) = tab && let Err(why) = t.terminal.clear_scrollback() {
                model::report(window, "Couldn't clear the scrollback", why)
            }
        }
        commands::RESET | commands::RESET_AND_CLEAR => {
            if let Some(t) = tab {
                let mut done = t.terminal.reset()
                // Clearing erases the screen and its history, then asks the
                // program to draw again (Ctrl+L).
                if id == commands::RESET_AND_CLEAR {
                    done = done.and_then(|_| t.terminal.feed("\u{1b}[H\u{1b}[2J")).and_then(|_| t.terminal.clear_scrollback()).and_then(|_| t.terminal.input("\u{c}"))
                }
                if let Err(why) = done { model::report(window, "Couldn't reset the terminal", why) }
            }
        }
        commands::NEXT_TAB => model::cycle(m, w, 1)
        commands::PREVIOUS_TAB => model::cycle(m, w, -1)
        commands::LAST_TAB => model::last_active(m, w)
        commands::MOVE_LEFT | commands::MOVE_RIGHT => {
            let key = m.windows[w].leader_of(m.windows[w].active)
            if let Some(at) = m.windows[w].strip_index_of(key) {
                model::move_tab(m, w, key, at + if id == commands::MOVE_LEFT { -1 } else { 1 })
                model::retitle(m, w)
            }
        }
        commands::PIN_TAB => {
            let leader = m.windows[w].leader_of(m.windows[w].active)
            if let Some(at) = m.windows[w].index_of(leader) { model::pin(m, w, leader, !m.windows[w].tabs[at].pinned) }
        }
        commands::CLOSE_OTHER_TABS => {
            let active = m.windows[w].strip_index_of(m.windows[w].active).unwrap_or(-1)
            model::request_close_tabs(m, w, |i| i != active)
        }
        commands::CLOSE_TABS_RIGHT => {
            let active = m.windows[w].strip_index_of(m.windows[w].active).unwrap_or(-1)
            model::request_close_tabs(m, w, |i| active >= 0 && i > active)
        }
        commands::SPLIT_RIGHT | commands::SPLIT_DOWN => {
            if let Err(why) = model::open_pane(m, w, model::shell_here(*m, w), id == commands::SPLIT_RIGHT) { model::report(window, "Couldn't split the tab", why) }
        }
        commands::CLOSE_PANE => {
            if let Some(t) = tab { model::request_close_pane(m, t.key) }
        }
        commands::NEXT_PANE => model::step_pane(m, w, 1)
        commands::PREVIOUS_PANE => model::step_pane(m, w, -1)
        commands::GUIDE => gui::perform(Effect::OpenUrl(commands::GUIDE_URL))
        commands::SHORTCUTS => gui::perform(Effect::OpenUrl(commands::SHORTCUTS_URL))
        commands::CHECK_UPDATES => {
            if m.checking_window.is_empty() {
                m.checking_window = window
                releases::check()
            }
        }
        commands::ABOUT => gui::perform(Effect::OpenDialogIn(window, about()))
        _ => ()
    }
    if let Some(w) = model::window_index(*m, window) { model::retitle(m, w) }
}

fn open_settings(m: &mut Model, window: String) {
    let fonts = m.fonts.unwrap_or(#[])
    // Scheme files are read again, so one added since starting is offered.
    let found, problems = schemes::user()
    m.user_schemes = found
    for why in problems { gui::perform(Effect::Announce(why)) }
    let mut shown = m.settings
    if !m.offered_scheme.is_empty() { shown.scheme = m.offered_scheme }
    let registry = commands::registry(model::new(m.settings), window)
    gui::perform(Effect::OpenDialogIn(window, settings::dialog(shown, fonts, schemes::all(m.user_schemes), registry, m.shortcuts)))
}

// A button of the Settings window: the color scheme's.
fn settings_action(m: &mut Model, action: String) {
    let window = m.windows[0].key
    match action {
        "edit_scheme" => {
            let id = if m.offered_scheme.is_empty() { m.settings.scheme } else { m.offered_scheme }
            m.editing_scheme = id
            gui::perform(Effect::OpenDialogIn(window, schemes::editor(schemes::find(schemes::all(m.user_schemes), id))))
        }
        "import_scheme" => {
            let filters = #[request::FileFilter { name: "Color schemes", patterns: #["*.itermcolors", "*.json", "*.theme", "*.yaml", "*.yml", "*.toml"] }]
            gui::perform(Effect::OpenDialogIn(window, request::open_file("import-scheme", "Import Scheme", filters)))
        }
        "export_scheme" => {
            let id = if m.offered_scheme.is_empty() { m.settings.scheme } else { m.offered_scheme }
            m.editing_scheme = id
            let e = schemes::find(schemes::all(m.user_schemes), id)
            let filters = #[request::FileFilter { name: "waftty schemes", patterns: #["*.toml"] }]
            gui::perform(Effect::OpenDialogIn(window, request::save_file("export-scheme", "Export Scheme", f"scheme-{schemes::slug(e.name)}.toml", filters)))
        }
        "scheme_folder" => {
            let folder = services::config_dir(info::APP_ID)
            let _ = fs::create_dir_all(folder)
            gui::perform(Effect::OpenUrl(f"file://{folder}"))
        }
        _ => ()
    }
}

// Saves scheme `e` and offers it in the open Settings window, chosen.
fn save_scheme(m: &mut Model, e: schemes::Entry) {
    if let Err(why) = schemes::write(e) {
        model::report(m.windows[0].key, "The scheme couldn't be saved", why)
        return
    }
    m.offered_scheme = e.id
    open_settings(m, m.windows[0].key)
}

// A tab strip request for tab `key` of window `window`.
fn tab_action(m: &mut Model, window: String, key: String, action: String) {
    let Some(w) = model::window_index(*m, window) else { return }
    let at = m.windows[w].strip_index_of(key).unwrap_or(-1)
    match action {
        "close" => model::request_close_tab(m, key)
        "close-others" => model::request_close_tabs(m, w, |i| i != at)
        "close-right" => model::request_close_tabs(m, w, |i| at >= 0 && i > at)
        "pin" | "unpin" => model::pin(m, w, key, action == "pin")
        "detach" => model::detach_tab(m, w, key, None)
        "move-left" | "move-right" => {
            if at >= 0 { model::move_tab(m, w, key, at + if action == "move-left" { -1 } else { 1 }) }
        }
        _ => ()
    }
    if let Some(w) = model::window_index(*m, window) { model::retitle(m, w) }
}

fn send_signal(m: &mut Model, w: i64, number: i64) {
    let Some(tab) = m.windows[w].current() else { return }
    if let Err(why) = tab.terminal.signal(number) {
        model::report(m.windows[w].key, f"Couldn't send signal {number}", why)
    }
}

fn set_encoding(m: &mut Model, w: i64, label: String) {
    let Some(t) = m.windows[w].index_of(m.windows[w].active) else { return }
    match m.windows[w].tabs[t].terminal.set_encoding(label) {
        Ok(()) => m.windows[w].tabs[t].encoding = label
        Err(why) => model::report(m.windows[w].key, f"{label} isn't available", why)
    }
}

// What terminal `id` reported.
fn terminal_event(m: &mut Model, id: i64, event: Event) {
    let Some(loc) = model::terminal_location(*m, id) else { return }
    let w, t = loc
    let window = m.windows[w].key
    match event {
        Event::Title(title) => {
            m.windows[w].tabs[t].title = title
            model::retitle(m, w)
        }
        Event::Bell => {
            if m.settings.bell == "sound" { let _ = windowing::system::beep() }
            call_attention(m, w, t)
        }
        Event::Notify(title, body) => {
            if m.settings.notifications && !in_front(*m, w, t) {
                let heading = if title.is_empty() { m.windows[w].tabs[t].label() } else { title }
                gui::perform(Effect::Notify { id: f"notify:{m.windows[w].tabs[t].key}", title: heading, body: body, urgency: Urgency::Normal })
            }
            call_attention(m, w, t)
        }
        Event::Clipboard(text) => {
            if m.settings.clipboard_write { gui::perform(Effect::SetClipboard(text)) }
        }
        Event::PrimarySelection(text) => {
            if m.settings.clipboard_write { gui::perform(Effect::SetPrimarySelection(text)) }
        }
        Event::PathActivated(path, line, col) => open_path(m, w, path, line, col)
        Event::PasteHeld(text) => hold_paste(m, w, t, text)
        Event::Exited(code) => {
            if m.windows[w].tabs[t].hold {
                // The tab keeps the program's last screen, with its status.
                let _ = m.windows[w].tabs[t].terminal.feed(f"\r\n[{m.windows[w].tabs[t].name} exited with status {code}]")
            } else {
                model::close_tab(m, w, t)
            }
        }
        Event::Failed(why) => {
            model::close_tab(m, w, t)
            if model::window_index(*m, window).is_some() { model::report(window, "waftty lost track of the program in this tab", errors::new(why)) }
        }
        Event::NotStarted(why) => {
            model::close_tab(m, w, t)
            if model::window_index(*m, window).is_some() { model::report(window, "The program in this tab couldn't start", errors::new(why)) }
        }
        Event::Refused(why) => model::report(window, "The terminal couldn't do that", errors::new(why))
        Event::LinkPointed(uri) => m.windows[w].tabs[t].link = uri
        Event::LinkActivated(uri) => gui::perform(Effect::OpenUrl(uri))
        Event::Foreground(job, cwd) => {
            m.windows[w].tabs[t].job = job
            m.windows[w].tabs[t].cwd = cwd
            if !m.windows[w].tabs[t].private && !cwd.is_empty() && m.recent_dirs.first() != Some(cwd) {
                m.recent_dirs = recent::visited(m.recent_dirs, cwd)
                recent::save(m.recent_dirs)
            }
            model::retitle(m, w)
        }
        Event::Focused => {
            if m.windows[w].active != m.windows[w].tabs[t].key { model::focus_pane(m, w, m.windows[w].tabs[t].key) }
            // A click that gives a terminal the focus leaves the palette
            // and Recent Directories.
            m.windows[w].palette = false
            m.windows[w].recent = false
        }
    }
}

// Asks before pasting `text`, which runs commands or sends control
// characters, into tab `t` of window `w`.
fn hold_paste(m: &mut Model, w: i64, t: i64, text: String) {
    let tab = m.windows[w].tabs[t]
    let lines = text.trim_end_matches("\n").lines().len()
    let detail = if lines > 1 { f"The text has {lines} lines; the shell may run each one as a command." } else { "The text holds control characters, which a program may act on." }
    m.held_paste = Some((tab.key, text))
    let title = if lines > 1 { f"Paste {lines} lines?" } else { "Paste control characters?" }
    gui::perform(Effect::OpenDialogIn(m.windows[w].key, request::confirm(f"paste:{tab.key}", title, detail, "Paste", false)))
}

// Whether tab `t` of window `w` is in front of the user: shown in a window
// with focus.
fn in_front(m: Model, w: i64, t: i64) -> bool {
    let win = m.windows[w]
    win.focused && win.leader_of(win.active) == win.leader_of(win.tabs[t].key)
}

// Marks tab `t` of window `w`, whose program asks for the user, and the
// window when it lacks focus.
fn call_attention(m: &mut Model, w: i64, t: i64) {
    if in_front(*m, w, t) { return }
    m.windows[w].tabs[t].attention = true
    if !m.windows[w].focused { gui::perform(Effect::RequestAttention(m.windows[w].key)) }
}

/// The program and arguments the editor setting `template` runs for a
/// place, with {path}, {line} and {col} filled in; the template's words
/// split as a command line, so a quoted path with spaces stays whole.
pub fn editor_command(template: String, path: String, line: i64, col: i64) -> Vec<String> {
    settings::words(template).map(|word| word.replace("{path}", path).replace("{line}", f"{line.max(1)}").replace("{col}", f"{col.max(1)}"))
}

// Opens the file a Ctrl+click on the screen named: in the editor the
// settings name, in a new tab, else with the desktop's opener.
fn open_path(m: &mut Model, w: i64, path: String, line: i64, col: i64) {
    if m.settings.editor.is_empty() {
        gui::perform(Effect::OpenUrl(f"file://{path}"))
        return
    }
    let words = editor_command(m.settings.editor, path, line, col)
    if words.is_empty() { return }
    let here = model::shell_here(*m, w)
    let command = gui::terminal::Command { program: words[0], args: words.skip(1), cwd: here.cwd, env: #[] }
    if let Err(why) = model::open_tab(m, w, command) {
        model::report(m.windows[w].key, "Couldn't open the editor", why)
    }
}

fn apply_settings(m: &mut Model, values: Map<String, String>) {
    let registry = commands::registry(model::new(m.settings), "main")
    let chosen_keys = settings::chosen_shortcuts(values, registry)
    if chosen_keys != m.shortcuts {
        let problems = shortcuts::problems(chosen_keys, registry)
        if !problems.is_empty() { model::report(m.windows[0].key, "Some shortcuts were not used", errors::new(problems.join("\n"))) }
        m.shortcuts = chosen_keys
        if let Err(why) = shortcuts::save(chosen_keys) { model::report(m.windows[0].key, "Couldn't save the shortcuts", why) }
    }
    store_settings(m, settings::with_values(m.settings, values))
}

// Takes settings `chosen`, puts their window theme in place and saves them.
fn store_settings(m: &mut Model, chosen: settings::Settings) {
    if chosen == m.settings { return }
    if m.drop_down { drop_down::settings_changed(m.settings, chosen, m.quick_position) }
    let font_changed = chosen.font != m.settings.font
    m.settings = chosen
    if font_changed { let _ = gui::text::fonts::preload(model::font(*m)) }
    gui::perform(schemes::theme_effect(model::scheme(*m)))
    gui::perform(Effect::SetTransparent(chosen.opacity < 100))
    if let Err(why) = settings::save(chosen) {
        model::report(m.windows[0].key, "Couldn't save the settings", why)
    }
}

/// The About window: what waftty is, its version, its license, what it is
/// built on, and where to read more.
pub fn about() -> DialogRequest {
    let license = "waftty is licensed under the Apache License 2.0. It includes SDL (zlib license), IBM Plex Mono (SIL Open Font License 1.1) and terminal code from WezTerm (MIT license)."
    DialogRequest::About {
        id: "about"
        name: info::NAME
        version: info::VERSION
        description: "A light, tabbed terminal emulator."
        credits: f"{license}\n\n{built_on()}"
        licenses: ""
        diagnostics: ""
        links: #[("Website", "https://danpozmanter.github.io/waftty/"), ("Guide", commands::GUIDE_URL)]
    }
}

fn built_on() -> String {
    f"Built on:\nGossamer {runtime::version()}\ngui-gos {gui::VERSION}\nSDL {windowing::sdl_version()}\nOS/Platform: {info::OS}/{os::arch()}"
}

#[cfg(test)]
mod tests {
    use std::fs

    use gui::UiMsg
    use gui::services

    use commands
    use model
    use recent
    use settings::Settings

    #[test]
    fn the_palette_toggles_on_its_command_and_closes_for_the_command_it_runs() {
        let mut m = model::new(Settings::default())
        m = super::update(m, UiMsg::Command(commands::COMMAND_PALETTE))
        assert(m.windows[0].palette)
        m = super::update(m, UiMsg::Command(commands::COMMAND_PALETTE))
        assert(!m.windows[0].palette)
        m = super::update(m, UiMsg::Command(commands::COMMAND_PALETTE))
        m = super::update(m, UiMsg::Command(commands::ZOOM_IN))
        assert(!m.windows[0].palette)
        assert_eq(m.windows[0].zoom, commands::ZOOM_STEP)
        m = super::update(m, UiMsg::Command(commands::COMMAND_PALETTE))
        m = super::update(m, UiMsg::Command(commands::CLOSE_PALETTE))
        assert(!m.windows[0].palette)
    }

    #[test]
    fn clearing_recent_directories_empties_the_list_and_disables_itself() {
        // The command deletes the list's file, so it runs against a folder of
        // the test's own, never the user's configuration.
        let Ok(root) = fs::temp_dir("waftty-recent-") else { panic("no temporary folder") }
        services::set_config_root(root)
        defer {
            services::set_config_root("")
            let _ = fs::remove_dir_all(root)
        }
        recent::save(#["/tmp"])
        let mut m = model::new(Settings::default())
        m.recent_dirs = #["/tmp", "/srv"]
        let enabled = |m: model::Model| commands::registry(m, "main").iter().find(|c| c.id == commands::CLEAR_RECENT).map(|c| c.enabled)
        assert_eq(enabled(m), Some(true))
        m = super::update(m, UiMsg::Command(commands::CLEAR_RECENT))
        assert(m.recent_dirs.is_empty())
        assert(recent::load().is_empty())
        assert_eq(enabled(m), Some(false))
    }

    #[test]
    fn built_on_names_the_toolchain_and_not_waftty() {
        let lines = super::built_on().split("\n")
        assert_eq(lines[0], "Built on:")
        assert(lines[1].starts_with("Gossamer "))
        assert(lines[2].starts_with("gui-gos "))
        assert(lines[3].starts_with("SDL 3."))
        assert(lines[4].starts_with("OS/Platform: "))
        assert(!super::built_on().contains("waftty"))
    }

    #[test]
    fn the_platform_is_named_for_its_system() {
        let line = super::built_on().split("\n")[4]
        assert(line.starts_with("OS/Platform: Linux/") || line.starts_with("OS/Platform: macOS/") || line.starts_with("OS/Platform: Windows/"), line)
    }

    #[test]
    fn an_editor_template_keeps_quoted_words_whole() {
        assert_eq(super::editor_command("'/Applications/Sublime Text.app/Contents/SharedSupport/bin/subl' {path}:{line}", "/tmp/a b.txt", 3, 0), #["/Applications/Sublime Text.app/Contents/SharedSupport/bin/subl", "/tmp/a b.txt:3"])
        assert_eq(super::editor_command("vim +{line} {path}", "/x", 0, 0), #["vim", "+1", "/x"])
    }
}

// A later `--single-instance` launch forwarded its command line: it opens a
// window here, as that launch would have opened its own.
fn launched(m: &mut Model, directory: String, arguments: Vec<String>) {
    if m.drop_down {
        drop_down::summon(m)
        return
    }
    let Ok(cli::Invocation::Open(launch)) = cli::invocation(arguments) else { return }
    let title = launch.title
    let hold = launch.hold
    match model::open_window(m, cli::first_command(launch, m.settings, directory)) {
        Ok(()) => {
            let w = m.windows.len() - 1
            m.windows[w].tabs[0].fixed_title = title
            m.windows[w].tabs[0].hold = hold
        }
        Err(why) => model::report(m.windows[0].key, "Couldn't open the window a launch asked for", why)
    }
}
