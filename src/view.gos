// What a window shows: its menu bar, unless the settings hide it, over the
// active tab's terminal, with a tab strip joined between them as the
// settings ask, and the find bar under the terminal while it is open.

use std::{fs, process}

use gui
use gui::{Axis, Color, Edge, TabItem, ThemeOverride, Widget}
use gui::text::layout::TextAlign
use gui::widgets::collections::{Collection, Column, Row}

use clock
use commands
use drop_down
use model
use model::Model
use panes::Layout
use processes
use sessions
use settings
use signals

/// The main window.
pub fn main(m: Model) -> Widget {
    window(m, "main")
}

/// Window `key`.
pub fn window(m: Model, key: String) -> Widget {
    let Some(w) = model::window_index(m, key) else { return Widget::Empty }
    let win = m.windows[w]
    let leader = win.leader_of(win.active)
    let terminal = if win.index_of(leader).is_some() { page(m, w, leader) } else { Widget::Empty }
    let tabs = win.strip()
    let strip = match m.settings.tab_bar {
        "always" => !tabs.is_empty()
        "never" => false
        _ => tabs.len() > 1
    }
    let body = if strip {
        let items = tabs.map(|t| {
            let shown = win.shown(t.key).unwrap_or(t)
            let attention = win.members(t.key).any(|k| win.tabs.any(|p| p.key == k && p.attention))
            TabItem::new(t.key, shown.label()).pinned(t.pinned).attention(attention).tooltip(tooltip(shown))
        })
        let mut pages = Map::new()
        for t in tabs { pages[t.key] = if t.key == leader { terminal } else { page(m, w, t.key) } }
        Widget::joined_tab_pages(win.strip_id(), model::TAB_WORKSPACE, items, leader, pages).grow(1)
    } else {
        terminal
    }
    let mut rows = #[]
    // The quick terminal shows no menu bar, as Guake shows none.
    if m.settings.menu_bar && !m.drop_down { rows.push(commands::menu_bar(m, key)) }
    rows.push(body)
    let chrome = match chrome_of(m) {
        Some(change) => Widget::column(rows, 0).grow(1).themed(change)
        None => Widget::column(rows, 0).grow(1)
    }
    let mut parts = #[chrome, win.find.view()]
    if m.settings.status_bar { parts.push(status_bar(m)) }
    let mut content = Widget::column(parts, 0)
    let menu_bar = m.settings.menu_bar && !m.drop_down
    if win.palette { content = Widget::stack(#[content, hanging(Widget::command_palette(commands::PALETTE_FIELD), menu_bar)]) }
    if win.recent { content = Widget::stack(#[content, hanging(recent(m, w), menu_bar)]) }
    if win.sessions { content = Widget::stack(#[content, hanging(sessions(m, w), menu_bar)]) }
    if win.processes { content = Widget::stack(#[content, processes_panel(m, w).width(780).margin_sides(0, if menu_bar { 36 } else { 8 }, 0, 0).align(0.5, 0.0).pass_through()]) }
    if m.drop_down && win.key == "main" { edged(content.grow(1), drop_down::position(m.settings, m.quick_position)) } else { content }
}

// `list` (the command palette or Recent Directories) hanging from the top
// of the window, under the menu bar when it shows, over the terminal; a
// click beside it reaches the terminal.
fn hanging(list: Widget, menu_bar: bool) -> Widget {
    list.width(560).margin_sides(0, if menu_bar { 36 } else { 8 }, 0, 0).align(0.5, 0.0).pass_through()
}

// Recent Directories for window `w`: the directories tabs worked in, latest
// first, without the one the window shows or any that is gone.
fn recent(m: Model, w: i64) -> Widget {
    let here = match m.windows[w].current() { Some(t) => t.cwd, None => "" }
    let dirs = m.recent_dirs.filter(|d| d != here && fs::exists(d))
    let items = Widget::items(dirs.map(|d| (d, model::shortened(d))))
    Widget::quick_pick(commands::recent_field(m.windows[w].key), items, "Recent directories", "No recent directories")
}

// The status bar: what waftty and everything its tabs started use.
fn status_bar(m: Model) -> Widget {
    let text = if m.monitor.rows.is_empty() { "" } else { processes::status_text(processes::totals(m.monitor.rows)) }
    Widget::muted(text).margin_sides(8, 2, 8, 3)
}

// Processes for window `w`: waftty and every process its tabs started, in
// a table sorted as asked, with a signal to send the chosen one.
fn processes_panel(m: Model, w: i64) -> Widget {
    let key = m.windows[w].key
    let sort, ascending = m.monitor.sort
    let rows = processes::sorted(m.monitor.rows, sort, ascending)
    let number = |title: String, column: String, width: i64| Column { align: TextAlign::End, ..Column::new(column, title, width) }
    let columns = #[
        Column::new("name", "Process", 170), number("PID", "pid", 70), Column::new("tab", "Tab", 190), number("CPU", "cpu", 70)
        number("Memory", "memory", 80), number("Read", "read", 80), number("Written", "written", 80)
    ]
    let table = Collection::new(commands::processes_table(key), rows.len(), |i| {
        let r = rows[i]
        let name = if r.pid == process::id() { f"{r.name} (waftty)" } else { r.name }
        Row { cells: #[name, f"{r.pid}", r.tab, processes::cpu_text(r.cpu), processes::size_text(r.memory), processes::rate_text(r.read), processes::rate_text(r.written)], ..Row::new(f"{r.pid}", name) }
    }).columns(columns).sorted_by(sort, ascending).selected(if m.monitor.selected > 0 { #[f"{m.monitor.selected}"] } else { #[] })
        .revision(m.monitor.revision, #[]).rows(12).label("Processes").empty_text("Reading processes…")
    let chosen = rows.iter().find(|r| r.pid == m.monitor.selected)
    // waftty itself quits from its own menu, not from here.
    let sendable = chosen.map(|r| r.pid != process::id()).unwrap_or(false)
    let mut actions = #[]
    if signals::supported() {
        let offered = Widget::items(signals::table().map(|s| (f"{s.number}", signals::label(s))))
        actions.push(Widget::select(commands::processes_signal(key), offered, f"{m.monitor.signal}", "Signal").width(240))
        actions.push(Widget::button(commands::processes_send(key), "Send Signal").disabled(!sendable))
    } else {
        actions.push(Widget::button(commands::processes_send(key), "End Process").disabled(!sendable))
    }
    actions.push(Widget::stretch())
    actions.push(Widget::button(commands::processes_close(key), "Close"))
    Widget::card(Widget::column(#[Widget::heading("Processes"), Widget::collection(table), Widget::row(actions, 8)], 8))
}

// Recent Sessions for window `w`: the agent sessions tabs ran, latest first,
// without any whose folder is gone.
fn sessions(m: Model, w: i64) -> Widget {
    let shown = m.recent_sessions.filter(|s| fs::is_dir(s.dir))
    let items = Widget::items(shown.map(|s| (sessions::key(s), session_label(s))))
    Widget::quick_pick(commands::sessions_field(m.windows[w].key), items, "Recent sessions", "No recent sessions")
}

// "claude · Login page fix · ~/dev/site · 11/13/26 1:20PM": the agent, the
// session's title, its folder, and when it began.
fn session_label(s: sessions::Session) -> String {
    let title = if s.empty { "New session" } else if s.title.is_empty() { "Untitled session" } else { s.title }
    let label = f"{s.agent} \u{b7} {title} \u{b7} {model::shortened(s.dir)}"
    let started = sessions::started_text(s, clock::local_offset(s.started))
    if started.is_empty() { label } else { f"{label} \u{b7} {started}" }
}

// The quick terminal has no frame, so a rule marks its edge facing the rest
// of the display, where dragging resizes it.
fn edged(content: Widget, position: String) -> Widget {
    match drop_down::edge(position) {
        Edge::Top => Widget::column(#[content, Widget::separator()], 0)
        Edge::Bottom => Widget::column(#[Widget::separator(), content], 0)
        Edge::Left => Widget::row(#[content, Widget::vseparator()], 0)
        Edge::Right => Widget::row(#[Widget::vseparator(), content], 0)
    }
}

// The menu bar and tab strip join the terminal under them, so a scheme with
// colors of its own colors them too: the active tab takes the terminal's
// background and the bars a shade of it.
fn chrome_of(m: Model) -> Option<ThemeOverride> {
    let colors = model::scheme(m).colors?
    let ground = Color::parse_css(colors.background)?
    let shade = ground.mix(Color::black(), if ground.luminance() < 0.5 { 0.3 } else { 0.08 })
    Some(ThemeOverride { kind: None, density: None, rtl: None, text_scale: 0.0, tokens: None, focus: None, accent: None, surface: Some(ground), field: Some(shade) })
}

// What strip tab `leader` of window `w` shows: its terminal, or its panes
// as its layout arranges them.
fn page(m: Model, w: i64, leader: String) -> Widget {
    match m.windows[w].layouts.get(leader) {
        Some(layout) => arranged(m, w, leader, layout, "")
        None => pane(m, w, leader)
    }
}

// The terminal of pane `key` in window `w`.
fn pane(m: Model, w: i64, key: String) -> Widget {
    let win = m.windows[w]
    let Some(at) = win.index_of(key) else { return Widget::Empty }
    let tab = win.tabs[at]
    tab.terminal.view(tab.view_id(), "Terminal", font: model::font(m), font_size: model::font_size(m, w), scheme: model::scheme(m).colors, options: Some(settings::view_options(m.settings)))
        .context_menu(f"terminal-menu:{win.key}:{key}", commands::context_menu(m.drop_down))
        .grow(1)
}

// The panes of split tab `leader` as `layout` arranges them; `path` names
// the split reached so far, as `split_of` reads it back.
fn arranged(m: Model, w: i64, leader: String, layout: Layout, path: String) -> Widget {
    match layout {
        Layout::Pane(key) => pane(m, w, key)
        Layout::Split { across, ratio, first, second } => {
            let axis = if across { Axis::Horizontal } else { Axis::Vertical }
            let id = f"{SPLIT_PREFIX}{m.windows[w].key}|{leader}|{path}"
            Widget::split(id, arranged(m, w, leader, first, f"{path}a"), arranged(m, w, leader, second, f"{path}b"), axis, ratio).grow(1)
        }
    }
}

const SPLIT_PREFIX: String = "split|"

/// The window, split tab and split path a divider's id names.
pub fn split_of(id: String) -> Option<(String, String, String)> {
    if !id.starts_with(SPLIT_PREFIX) { return None }
    let parts = id.substring(SPLIT_PREFIX.byte_len(), id.byte_len()).split("|")
    if parts.len() != 3 { return None }
    Some((parts[0], parts[1], parts[2]))
}

// The tab's label and, when its program set one, the program's own title.
fn tooltip(t: model::Tab) -> String {
    if !t.title.is_empty() && t.title != t.label() { f"{t.label()}\n{t.title}" } else { t.label() }
}
