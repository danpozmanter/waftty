// What a window shows: its menu bar, unless the settings hide it, over the
// active tab's terminal, with a tab strip joined between them as the
// settings ask, and the find bar under the terminal while it is open.

use gui
use gui::{TabItem, Widget}

use commands
use model
use model::Model
use settings

/// The main window.
pub fn main(m: Model) -> Widget {
    window(m, "main")
}

/// Window `key`.
pub fn window(m: Model, key: String) -> Widget {
    let Some(w) = model::window_index(m, key) else { return Widget::Empty }
    let win = m.windows[w]
    let options = settings::view_options(m.settings)
    let terminal = match win.current() {
        Some(tab) => tab.terminal.view(tab.view_id(), "Terminal", font: model::font(m), font_size: model::font_size(m, w), scheme: model::scheme(m).colors, options: Some(options))
            .context_menu(f"terminal-menu:{key}", commands::context_menu())
            .grow(1)
        None => Widget::Empty
    }
    let strip = match m.settings.tab_bar {
        "always" => !win.tabs.is_empty()
        "never" => false
        _ => win.tabs.len() > 1
    }
    let body = if strip {
        let items = win.tabs.map(|t| TabItem::new(t.key, t.label()).pinned(t.pinned).attention(t.attention).tooltip(tooltip(t)))
        Widget::joined_tabs(win.strip_id(), items, win.active, terminal).grow(1)
    } else {
        terminal
    }
    let mut rows = #[]
    if m.settings.menu_bar { rows.push(commands::menu_bar(m, key)) }
    rows.push(body)
    rows.push(win.find.view())
    Widget::column(rows, 0)
}

// The tab's title and, when known, the folder its program works in.
fn tooltip(t: model::Tab) -> String {
    match t.terminal.cwd() {
        Ok(dir) if !dir.is_empty() && dir != t.label() => f"{t.label()}\n{dir}"
        _ => t.label()
    }
}
