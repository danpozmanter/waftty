// The application: its model, update and view, and the windows' settings.

use std::{env, errors}

use gui
use gui::terminal::Command

use commands
use drop_down
use icon
use info
use model
use model::Model
use recent
use schemes
use settings
use settings::Settings
use shortcuts
use update
use view

/// What the command line asked of the first tab besides its program.
#[derive(Debug, Default, PartialEq)]
pub struct FirstTab {
    /// Names the tab whatever titles its program sets; empty for none.
    pub title: String
    /// Keeps the tab open once its program exits.
    pub hold: bool
    /// Opens the window as a quick terminal (`--quick`).
    pub quick: bool
    /// The edge the quick terminal hangs from; empty for the one Settings names.
    pub quick_position: String
}

/// The single instance a quick terminal claims, apart from the one
/// `--single-instance` windows share under the app id.
pub const QUICK_INSTANCE: String = "dev.gossamer.waftty.Quick"

fn init(s: Settings, first: Command, first_tab: FirstTab, restore: bool, program_env: Vec<(String, String)>) -> Model {
    let mut m = model::new(s)
    m.program_env = program_env
    m.recent_dirs = recent::load()
    m.desktop_font = settings::desktop_font()
    let found, scheme_problems = schemes::user()
    m.user_schemes = found
    gui::perform(schemes::theme_effect(model::scheme(m)))
    if let Err(why) = model::open_tab(&mut m, 0, first) {
        eprintln(f"{info::NAME}: {why}")
        gui::perform(gui::Effect::Quit)
        return m
    }
    m.windows[0].tabs[0].fixed_title = first_tab.title
    m.windows[0].tabs[0].hold = first_tab.hold
    if first_tab.quick {
        m.drop_down = true
        m.quick_position = first_tab.quick_position
        drop_down::start(m)
    }
    if restore { reopen(&mut m) }
    let mut problems = scheme_problems
    match shortcuts::load() {
        Ok(chosen) => {
            m.shortcuts = chosen
            for why in shortcuts::problems(chosen, commands::registry(model::new(s), "main")) { problems.push(why) }
        }
        Err(why) => problems.push(f"{why}")
    }
    if !problems.is_empty() {
        let found = problems.join("\n")
        model::report("main", "Some settings were not used", errors::new(found))
    }
    m
}

// Opens the windows and tabs of the session saved at the last quit: the
// first window's first tab is the one already open in its folder.
fn reopen(m: &mut Model) {
    let Some(saved) = model::saved_session() else { return }
    let mut w = 0
    for window in saved.windows {
        for (i, folder) in window.folders.iter().enumerate() {
            let mut command = model::shell(*m)
            if !folder.is_empty() { command.cwd = folder }
            let opened = if w == 0 && i == 0 { Ok(()) } else if i == 0 { model::open_window(m, command) } else { model::open_tab(m, m.windows.len() - 1, command) }
            if let Err(why) = opened { eprintln(f"{info::NAME}: {why}") }
        }
        w += 1
    }
}

/// The application with settings `s`, its first tab running `first`; with
/// `restore`, the windows and tabs saved at the last quit open after it.
/// `instance` is the command line a `--single-instance` launch hands to the
/// running instance.
pub fn app(s: Settings, first: Command, first_tab: FirstTab, restore: bool, program_env: Vec<(String, String)>, instance: Option<Vec<String>>) -> gui::App<Model> {
    let width, height = model::window_size(s, s.font_size)
    let built = gui::application(info::NAME, info::APP_ID, || init(s, first, first_tab, restore, program_env), update::update, view::main)
        .size(width, height)
        .transparent(s.opacity < 100)
        .remember_size(s.remember_size)
        .min_size(360, 220)
        .window_commands(commands::window_commands)
        .windows(view::window)
        .ask_before_close()
        .icon(icon::waftty(128))
    // A second `--quick` launch hands its command line to the running quick
    // terminal, which already holds the shortcut and docks itself to show.
    if first_tab.quick { return built.frameless().remember_size(false).instance(QUICK_INSTANCE).single_instance_command_line(env::args()) }
    match instance {
        Some(arguments) => built.single_instance_command_line(arguments)
        None => built
    }
}
