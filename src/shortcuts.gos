// Shortcuts the user sets in `shortcuts.toml` in the configuration
// directory, each command id naming a chord or a list of them; an empty list
// leaves a command without one. What cannot work is reported, not dropped
// in silence.

use std::{errors, fs, path}
use std::encoding::{json, toml}

use gui::Command
use gui::input::Shortcut
use gui::services

use info

/// Where the shortcuts are read from.
pub fn file() -> String {
    path::join(services::config_dir(info::APP_ID), "shortcuts.toml")
}

/// The chords `text` (a `shortcuts.toml`) sets, by command id.
pub fn parse(text: String) -> Result<Map<String, Vec<String>>, errors::Error> {
    let value = json::parse(toml::to_json(text)?)?
    let mut out: Map<String, Vec<String>> = Map::new()
    for id in json::keys(value).unwrap_or(#[]) {
        let Some(set) = json::get(value, id) else { continue }
        if let Some(one) = json::as_str(set) {
            out[id] = #[one]
        } else if let Some(many) = json::as_array(set) {
            let mut chords = #[]
            for chord in many {
                let Some(text) = json::as_str(chord) else {
                    return Err(errors::new(f"{id}: a shortcut is a chord in quotes, such as \"Primary+Shift+T\""))
                }
                chords.push(text)
            }
            out[id] = chords
        } else {
            return Err(errors::new(f"{id}: a shortcut is a chord or a list of chords"))
        }
    }
    Ok(out)
}

/// The shortcuts in the configuration directory, or none when there is no
/// file; a file that does not read is the reason.
pub fn load() -> Result<Map<String, Vec<String>>, errors::Error> {
    let Ok(text) = fs::read_to_string(file()) else { return Ok(Map::new()) }
    parse(text).map_err(|why| errors::wrap(why, f"reading {file()}"))
}

// Why `chord` cannot work as a shortcut in a terminal, or "".
fn unusable(chord: String) -> String {
    let Some(parsed) = Shortcut::parse(chord) else { return f"\"{chord}\" is not a chord waftty reads" }
    let first = parsed.strokes[0]
    let mac = gui::input::platform_is_macos()
    let ctrl = first.ctrl || (first.primary && !mac)
    let meta = first.meta || (first.primary && mac)
    let alt, shift = first.alt, first.shift
    let name = gui::input::key_name(first.key)
    let printable = name.len() == 1
    let letter = printable && name[0].is_alphabetic()
    if printable && !ctrl && !alt && !meta {
        return f"\"{chord}\" is a key the terminal types"
    }
    if letter && ctrl && !alt && !shift && !meta {
        return f"\"{chord}\" is a Ctrl key programs need; add Shift"
    }
    // The terminal gives Ctrl+Alt with a letter to its program, as Meta and
    // the letter's control code.
    if letter && ctrl && alt && !meta {
        return f"\"{chord}\" is a Ctrl+Alt key programs read; use Ctrl+Shift"
    }
    if letter && alt && !ctrl && !meta {
        return f"\"{chord}\" is an Alt key programs read as Meta; add Ctrl"
    }
    ""
}

/// `shortcut` spelled as a chord the shortcuts file and Settings read back,
/// such as "Ctrl+Shift+T" or, on macOS, "Cmd+T".
pub fn spelled(shortcut: Shortcut) -> String {
    let mac = gui::input::platform_is_macos()
    shortcut.strokes.map(|s| {
        let mut parts = #[]
        if s.ctrl || (s.primary && !mac) { parts.push("Ctrl") }
        if s.alt { parts.push(if mac { "Option" } else { "Alt" }) }
        if s.shift { parts.push("Shift") }
        if s.meta || (s.primary && mac) { parts.push(if mac { "Cmd" } else { "Super" }) }
        parts.push(gui::input::key_name(s.key))
        parts.join("+")
    }).join(" ")
}

/// The chords of `text`, a Settings field that separates them with commas.
/// A comma that starts a chord or follows a `+` is the comma key itself,
/// as in "Ctrl+,".
pub fn chords(text: String) -> Vec<String> {
    let mut out = #[]
    let mut chord = String::new()
    for c in text {
        let part = chord.trim()
        if c == ',' && !part.is_empty() && !part.ends_with("+") {
            out.push(part)
            chord = String::new()
        } else {
            chord.push(c)
        }
    }
    let last = chord.trim()
    if !last.is_empty() { out.push(last) }
    out
}

/// Whether Settings offers a shortcut for command `id`: the commands of the
/// Send Signal, Set Encoding and tab lists are many and change, so they
/// are bound in the shortcuts file only.
pub fn bindable(id: String) -> bool {
    !id.starts_with("terminal.signal:") && !id.starts_with("terminal.encoding:") && !id.starts_with("tabs.show:")
}

// `text` quoted as a TOML basic string.
fn quoted(text: String) -> String {
    f"\"{text.replace("\\", "\\\\").replace("\"", "\\\"")}\""
}

/// Writes `chosen`, the chords that differ from the defaults, as the
/// shortcuts file.
pub fn save(chosen: Map<String, Vec<String>>) -> Result<(), errors::Error> {
    let mut ids = chosen.keys()
    ids.sort()
    let mut text = String::new()
    for id in ids {
        text += f"{quoted(id)} = [{chosen[id].map(quoted).join(", ")}]\n"
    }
    fs::create_dir_all(services::config_dir(info::APP_ID))?
    fs::write(file(), text.bytes())
}

/// The problems with `chosen` against the commands `registry` offers: ids
/// that name no command, and chords that cannot work.
pub fn problems(chosen: Map<String, Vec<String>>, registry: Vec<Command>) -> Vec<String> {
    let mut out = #[]
    let mut ids = chosen.keys()
    ids.sort()
    for id in ids {
        let Some(c) = registry.iter().find(|c| c.id == id) else {
            out.push(f"{id} is not a command")
            continue
        }
        for chord in chosen[id] {
            let why = if defaults_of(c).contains(chord) { "" } else { unusable(chord) }
            if !why.is_empty() { out.push(f"{id}: {why}") }
        }
    }
    // A chord set for two commands of one scope runs only one of them; a
    // scoped command takes its chord only while its widget has focus.
    let mut seen: Map<(String, String), String> = Map::new()
    for c in apply(registry, chosen) {
        for chord in c.shortcuts.map(spelled) {
            match seen.get((c.scope, chord)) {
                Some(other) => out.push(f"{chord} is set for both {other} and {c.label}")
                None => seen[(c.scope, chord)] = c.label
            }
        }
    }
    out
}

/// `registry` with the shortcuts `chosen` sets in place of the defaults;
/// a chord that cannot work is left out.
pub fn apply(registry: Vec<Command>, chosen: Map<String, Vec<String>>) -> Vec<Command> {
    registry.map(|c| {
        let Some(chords) = chosen.get(c.id) else { return c }
        let defaults = defaults_of(c)
        let mut out = Command { shortcuts: #[], ..c }
        for chord in chords {
            if defaults.contains(chord) || unusable(chord).is_empty() { out = out.key(chord) }
        }
        out
    })
}

// The chords command `c` has by default, which stay usable when chosen
// again: Copy's plain Ctrl+C serves text fields, which the terminal leaves
// to its program.
fn defaults_of(c: Command) -> Vec<String> {
    c.shortcuts.map(spelled)
}

#[cfg(test)]
mod tests {
    use gui::Command

    #[test]
    fn a_shortcuts_file_reads_one_chord_or_several_per_command() {
        let Ok(set) = super::parse("\"file.new-tab\" = \"Primary+Shift+Y\"\n\"tabs.next\" = [\"Ctrl+Tab\", \"Alt+Right\"]\n\"view.zoom-in\" = []\n") else {
            panic("the file did not read")
        }
        assert_eq(set["file.new-tab"], #["Primary+Shift+Y"])
        assert_eq(set["tabs.next"], #["Ctrl+Tab", "Alt+Right"])
        assert_eq(set["view.zoom-in"], #[])
        assert(super::parse("\"tabs.next\" = 3").is_err())
    }

    #[test]
    fn unknown_commands_and_chords_a_terminal_cannot_give_up_are_reported_and_left_out() {
        let registry = #[Command::new("file.new-tab", "New Tab").key("Primary+Shift+T"), Command::new("tabs.next", "Next Tab")]
        let chosen = { "file.new-tab": #["Ctrl+T", "Ctrl+Shift+Y"], "tabs.next": #["x"], "no.such": #["F5"] }
        let found = super::problems(chosen, registry)
        assert_eq(found.len(), 3, f"{found}")
        assert(found[0].contains("Ctrl key programs need"))
        assert(found[1].contains("no.such"))
        assert(found[2].contains("the terminal types"))
        let applied = super::apply(registry, chosen)
        assert_eq(applied[0].shortcuts.len(), 1)
        assert_eq(applied[1].shortcuts.len(), 0)
    }

    #[test]
    fn a_ctrl_alt_letter_is_reported_as_the_programs() {
        let registry = #[Command::new("terminal.close-pane", "Close Pane")]
        let found = super::problems({ "terminal.close-pane": #["Ctrl+Alt+W"] }, registry)
        assert_eq(found.len(), 1, f"{found}")
        assert(found[0].contains("Ctrl+Alt key programs read"))
        assert_eq(super::problems({ "terminal.close-pane": #["Ctrl+Alt+Left"] }, registry), #[])
    }

    #[test]
    fn a_scoped_command_shares_a_chord_only_with_commands_outside_its_scope() {
        let apart = #[Command::new("terminal.find-close", "Close Find").key("Escape"), Command::new("view.close-command-palette", "Close Command Palette").key("Escape").in_scope("command-palette")]
        assert_eq(super::problems(Map::new(), apart), #[])
        let together = #[Command::new("a", "A").key("Escape").in_scope("p"), Command::new("b", "B").key("Escape").in_scope("p")]
        let found = super::problems(Map::new(), together)
        assert_eq(found.len(), 1, f"{found}")
        assert(found[0].ends_with("is set for both A and B"))
    }

    #[test]
    fn a_chord_set_for_two_commands_is_reported() {
        let registry = #[Command::new("file.new-tab", "New Tab").key("Ctrl+Shift+T"), Command::new("tabs.next", "Next Tab").key("Ctrl+Tab")]
        let found = super::problems({ "tabs.next": #["Ctrl+Shift+T"] }, registry)
        assert_eq(found, #["Ctrl+Shift+T is set for both New Tab and Next Tab"])
    }
}
