// The commands a window offers and the menu bar that names them. A
// terminal takes plain Ctrl chords with letters for its program, so on Linux
// and Windows waftty's shortcuts sit on Ctrl+Shift, as in other desktop
// terminals; on macOS they sit on Command, which programs never read.

use gui
use gui::Command
use gui::widgets::menus
use gui::widgets::menus::{Menu, MenuItem}

use encodings
use model
use model::Model
use shortcuts
use signals

