pub const NEW_WINDOW: String = "file.new-window"
pub const NEW_PRIVATE_TAB: String = "file.new-private-tab"
pub const NEW_PRIVATE_WINDOW: String = "file.new-private-window"
pub const CLOSE_TAB: String = "file.close-tab"
pub const CLOSE_WINDOW: String = "file.close-window"
pub const QUIT: String = "file.quit"
pub const SAVE_SCROLLBACK: String = "file.save-scrollback"
pub const SAVE_SELECTION: String = "file.save-selection"
pub const EDIT_SCROLLBACK: String = "file.edit-scrollback"
